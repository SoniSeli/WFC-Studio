# Normalize line endings for text files
* text=auto

# Code and text assets
*.cs      text diff=csharp
*.asmdef  text
*.json    text
*.md      text
*.uss     text
*.uxml    text
*.shader  text
*.hlsl    text
*.yml     text

# Unity YAML: merged with UnityYAMLMerge (Smart Merge) when the driver is configured,
# and marked generated so GitHub collapses their diffs and leaves them out of language stats.
*.unity       text eol=lf merge=unityyamlmerge linguist-generated
*.prefab      text eol=lf merge=unityyamlmerge linguist-generated
*.asset       text eol=lf merge=unityyamlmerge linguist-generated
*.mat         text eol=lf merge=unityyamlmerge linguist-generated
*.anim        text eol=lf merge=unityyamlmerge linguist-generated
*.controller  text eol=lf merge=unityyamlmerge linguist-generated
*.meta        text eol=lf merge=unityyamlmerge linguist-generated
*.inputactions text eol=lf linguist-generated
*.scenetemplate text eol=lf linguist-generated

# Binary assets in Git LFS
*.png       filter=lfs diff=lfs merge=lfs -text
*.jpg       filter=lfs diff=lfs merge=lfs -text
*.jpeg      filter=lfs diff=lfs merge=lfs -text
*.gif       filter=lfs diff=lfs merge=lfs -text
*.psd       filter=lfs diff=lfs merge=lfs -text
*.aseprite  filter=lfs diff=lfs merge=lfs -text
*.ttf       filter=lfs diff=lfs merge=lfs -text
*.otf       filter=lfs diff=lfs merge=lfs -text
*.wav       filter=lfs diff=lfs merge=lfs -text
*.mp3       filter=lfs diff=lfs merge=lfs -text
*.ogg       filter=lfs diff=lfs merge=lfs -text
*.mp4       filter=lfs diff=lfs merge=lfs -text
*.pdf       filter=lfs diff=lfs merge=lfs -text

# Users install the package from a git URL, where Git LFS may be missing: keep the package's images in plain git.
Packages/com.soniseli.wfc/**/*.png !filter !diff !merge binary

# README images, kept in plain git so GitHub shows them in the rendered README.
docs/images/** !filter !diff !merge binary
