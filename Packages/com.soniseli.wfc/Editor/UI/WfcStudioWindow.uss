.wfc-window {
  padding: 6px 4px;
}

.title {
  font-size: 16px;
  -unity-font-style: bold;
  margin-left: 3px;
}

.subtitle,
.hint {
  margin-left: 3px;
  white-space: normal;
  opacity: 0.7;
}

.section {
  margin-top: 8px;
}

.section > .unity-foldout__toggle {
  -unity-font-style: bold;
}

.row {
  flex-direction: row;
  align-items: center;
}

.grow {
  flex-grow: 1;
}

.buttons {
  margin-top: 4px;
}

.buttons > Button {
  flex-grow: 1;
  flex-basis: 0;
  height: 24px;
}

.primary {
  background-color: rgb(46, 125, 90);
  color: rgb(255, 255, 255);
  -unity-font-style: bold;
}

.primary:hover {
  background-color: rgb(56, 145, 105);
}

.status {
  margin: 6px 3px 0 3px;
  white-space: normal;
}

.issue {
  margin: 2px 3px;
  padding: 3px 6px;
  border-left-width: 3px;
  background-color: rgba(128, 128, 128, 0.08);
}

.issue--error {
  border-left-color: rgb(222, 72, 64);
}

.issue--warning {
  border-left-color: rgb(230, 175, 46);
}

.issue--info {
  border-left-color: rgb(110, 150, 200);
}

.issue-message {
  white-space: normal;
}

.issue-actions {
  flex-direction: row;
  justify-content: flex-end;
  margin-top: 2px;
}

.tile-search {
  width: auto;
  margin: 2px 3px 4px 3px;
}

.tile-list {
  height: 220px;
  margin: 0 3px;
  border-width: 1px;
  border-color: rgba(0, 0, 0, 0.3);
}

.tile-row {
  flex-direction: row;
  align-items: center;
  height: 24px;
  padding: 0 4px;
}

.thumb {
  width: 20px;
  height: 20px;
  flex-shrink: 0;
}

.tile-name {
  flex-grow: 1;
  margin-left: 6px;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tile-share {
  width: 48px;
  -unity-text-align: middle-right;
  opacity: 0.7;
}

.tile-weight {
  width: 56px;
  flex-shrink: 0;
}

.adjacency {
  margin: 8px 3px 0 3px;
  padding-top: 6px;
  border-top-width: 1px;
  border-color: rgba(128, 128, 128, 0.3);
}

.adjacency .hint {
  margin-left: 0;
}

.preview-large {
  width: 40px;
  height: 40px;
  margin-right: 8px;
}

.selected-name {
  -unity-font-style: bold;
}

.direction {
  margin-top: 6px;
}

.direction-title {
  -unity-font-style: bold;
  margin-bottom: 2px;
}

.thumbs {
  flex-direction: row;
  flex-wrap: wrap;
}

.neighbour {
  width: 24px;
  height: 24px;
  margin: 1px;
  border-radius: 2px;
}

.neighbour:hover {
  background-color: rgba(255, 255, 255, 0.15);
}

.hidden {
  display: none;
}
